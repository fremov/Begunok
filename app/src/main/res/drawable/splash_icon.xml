<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="heart"
                android:pivotX="54"
                android:pivotY="56"
                android:scaleX="0.6"
                android:scaleY="0.6">
                <path
                    android:fillColor="#FF6B2C"
                    android:pathData="M54,76 L36,58 C30,52 30,43 36,38 C41,34 48,35 54,42 C60,35 67,34 72,38 C78,43 78,52 72,58 Z" />
            </group>
            <path
                android:name="ecg"
                android:pathData="M34,52 L44,52 L48,44 L53,60 L58,48 L62,52 L74,52"
                android:strokeWidth="3"
                android:strokeColor="#FFFFFF"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:trimPathEnd="0" />
        </vector>
    </aapt:attr>
    <target android:name="heart">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <set>
                    <objectAnimator
                        android:duration="260"
                        android:propertyName="scaleX"
                        android:valueFrom="0.6"
                        android:valueTo="1.12"
                        android:interpolator="@android:interpolator/decelerate_cubic" />
                    <objectAnimator
                        android:duration="260"
                        android:propertyName="scaleY"
                        android:valueFrom="0.6"
                        android:valueTo="1.12"
                        android:interpolator="@android:interpolator/decelerate_cubic" />
                </set>
                <set>
                    <objectAnimator
                        android:duration="180"
                        android:propertyName="scaleX"
                        android:valueFrom="1.12"
                        android:valueTo="0.96" />
                    <objectAnimator
                        android:duration="180"
                        android:propertyName="scaleY"
                        android:valueFrom="1.12"
                        android:valueTo="0.96" />
                </set>
                <set>
                    <objectAnimator
                        android:duration="200"
                        android:propertyName="scaleX"
                        android:valueFrom="0.96"
                        android:valueTo="1" />
                    <objectAnimator
                        android:duration="200"
                        android:propertyName="scaleY"
                        android:valueFrom="0.96"
                        android:valueTo="1" />
                </set>
            </set>
        </aapt:attr>
    </target>
    <target android:name="ecg">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="600"
                android:propertyName="trimPathEnd"
                android:startOffset="250"
                android:valueFrom="0"
                android:valueTo="1"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
